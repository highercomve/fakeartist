# Port the host machine exposes (container always listens on 6060 internally).
HOST_PORT=6060

# Storage backend: json (file-based, default) | sqlite | mongo.
STORAGE_DRIVER=json

# When false, falls back to the legacy WS hub. Default true post-PR10.
P2P_ENABLED=true

# Set to true to skip esbuild minification (slightly faster startup during
# iteration; production should leave this false).
BUNDLE_DEV=false
